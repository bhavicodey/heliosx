# run.py creates .env from this file and asks for your project id on first run.
# or do it by hand: copy this file to ".env" and replace the value below with YOUR google cloud project id
EE_PROJECT=your-gcp-project-id

# Optional: only needed when deploying with a service account instead of the google sign-in
# EE_SERVICE_ACCOUNT=my-account@my-project.iam.gserviceaccount.com
# EE_KEY_FILE=C:/path/to/key.json
